generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TranactionType {
  INCOME
  EXPENSE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  expenses Expense[]
  budgets  Budget[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  expenses Expense[]
  budgets  Budget[]
}

model Expense {
  id          Int            @id @default(autoincrement())
  title       String
  amount      Float
  type        TranactionType @default(EXPENSE)
  description String?
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())

  userId     Int
  categoryId Int

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
}

model Budget {
  id        Int      @id @default(autoincrement())
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())

  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
}
